# CoinGecko — used by lib/coingecko.ts for every CoinGecko request site-wide.
# Get a Demo key at https://www.coingecko.com/en/api
# Never commit real keys. Copy to .env.local for local/dev.
#
# Local/dev: leave COINGECKO_LIVE unset (or false). The app uses mock data and
# will not call CoinGecko, so Cursor refreshes do not burn Demo quota.
# To test live locally: COINGECKO_LIVE=true and a valid COINGECKO_API_KEY.
#
# Vercel Production: set COINGECKO_LIVE=true (or leave unset — Production
# defaults to live when an API key is present). Preview/dev never live unless
# COINGECKO_LIVE=true.

COINGECKO_API_KEY=
# "demo" (default, free Demo API) or "pro" (paid Pro API host + header)
# Must match the key type. A Demo key with PLAN=pro (or the reverse) returns 401.
COINGECKO_API_PLAN=demo
# "true" to allow live CoinGecko calls. Unset/false in local development.
COINGECKO_LIVE=false
